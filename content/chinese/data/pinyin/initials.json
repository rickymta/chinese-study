{
  "dataset": "pinyin-initials",
  "version": "2026-09-17",
  "items": [
    { "code": "", "group": "khong", "display": "", "ipa": "", "aspirated": false,
      "noteVi": "Âm tiết bắt đầu ngay bằng nguyên âm (hoặc viết bằng y/w) — không có thanh mẫu.",
      "examples": [{ "pinyin": "ai4", "hanzi": "爱" }] },
    { "code": "b", "group": "moi", "display": "b", "ipa": "p", "aspirated": false,
      "noteVi": "Hai môi khép rồi mở nhẹ, không bật hơi — gần 'b' tiếng Việt hơn là 'p'.",
      "examples": [{ "pinyin": "bai2", "hanzi": "白" }] },
    { "code": "p", "group": "moi", "display": "p", "ipa": "pʰ", "aspirated": true,
      "noteVi": "Giống 'b' về vị trí môi nhưng bật hơi mạnh — đặt tay trước miệng sẽ thấy luồng hơi rõ.",
      "examples": [{ "pinyin": "pi2", "hanzi": "皮" }] },
    { "code": "m", "group": "moi", "display": "m", "ipa": "m", "aspirated": false,
      "noteVi": "Giống hệt 'm' tiếng Việt.",
      "examples": [{ "pinyin": "mu3", "hanzi": "母" }] },
    { "code": "f", "group": "moi", "display": "f", "ipa": "f", "aspirated": false,
      "noteVi": "Môi trên chạm răng dưới, giống 'ph'/'f' — không phải 'ph' tiếng Việt bật hơi.",
      "examples": [{ "pinyin": "fu2", "hanzi": "福" }] },
    { "code": "d", "group": "dau-luoi", "display": "d", "ipa": "t", "aspirated": false,
      "noteVi": "Đầu lưỡi chạm lợi trên, không bật hơi — gần 'đ' tiếng Việt hơn 't'.",
      "examples": [{ "pinyin": "dao1", "hanzi": "刀" }] },
    { "code": "t", "group": "dau-luoi", "display": "t", "ipa": "tʰ", "aspirated": true,
      "noteVi": "Như 'd' nhưng bật hơi mạnh — gần 't' tiếng Việt/tiếng Anh.",
      "examples": [{ "pinyin": "tian1", "hanzi": "天" }] },
    { "code": "n", "group": "dau-luoi", "display": "n", "ipa": "n", "aspirated": false,
      "noteVi": "Giống hệt 'n' tiếng Việt.",
      "examples": [{ "pinyin": "nan2", "hanzi": "男" }] },
    { "code": "l", "group": "dau-luoi", "display": "l", "ipa": "l", "aspirated": false,
      "noteVi": "Giống hệt 'l' tiếng Việt.",
      "examples": [{ "pinyin": "lao3", "hanzi": "老" }] },
    { "code": "g", "group": "cuong-luoi", "display": "g", "ipa": "k", "aspirated": false,
      "noteVi": "Cuống lưỡi chạm ngạc mềm, không bật hơi — gần 'c/k' tiếng Việt không bật hơi.",
      "examples": [{ "pinyin": "gao1", "hanzi": "高" }] },
    { "code": "k", "group": "cuong-luoi", "display": "k", "ipa": "kʰ", "aspirated": true,
      "noteVi": "Như 'g' nhưng bật hơi mạnh.",
      "examples": [{ "pinyin": "kai1", "hanzi": "开" }] },
    { "code": "h", "group": "cuong-luoi", "display": "h", "ipa": "x", "aspirated": false,
      "noteVi": "Ma sát ở cuống lưỡi — gần 'kh' tiếng Việt.",
      "examples": [{ "pinyin": "hai3", "hanzi": "海" }] },
    { "code": "j", "group": "mat-luoi", "display": "j", "ipa": "tɕ", "aspirated": false,
      "noteVi": "Mặt lưỡi áp lên ngạc cứng, không bật hơi. Luôn đi với i/ü — không đọc như 'ch' tiếng Việt.",
      "examples": [{ "pinyin": "jia1", "hanzi": "家" }] },
    { "code": "q", "group": "mat-luoi", "display": "q", "ipa": "tɕʰ", "aspirated": true,
      "noteVi": "Như 'j' nhưng bật hơi mạnh — không phải 'q' tiếng Việt.",
      "examples": [{ "pinyin": "qi1", "hanzi": "期" }] },
    { "code": "x", "group": "mat-luoi", "display": "x", "ipa": "ɕ", "aspirated": false,
      "noteVi": "Xát nhẹ giữa mặt lưỡi và ngạc — gần 'x' tiếng Việt nhưng lưỡi nâng cao hơn.",
      "examples": [{ "pinyin": "xin1", "hanzi": "心" }] },
    { "code": "zh", "group": "uon-luoi", "display": "zh", "ipa": "ʈʂ", "aspirated": false,
      "noteVi": "Uốn đầu lưỡi lên, không bật hơi. Đừng đọc thành 'tr' tiếng Việt.",
      "examples": [{ "pinyin": "zhong4", "hanzi": "众" }] },
    { "code": "ch", "group": "uon-luoi", "display": "ch", "ipa": "ʈʂʰ", "aspirated": true,
      "noteVi": "Như 'zh' nhưng bật hơi mạnh.",
      "examples": [{ "pinyin": "chi1", "hanzi": "吃" }] },
    { "code": "sh", "group": "uon-luoi", "display": "sh", "ipa": "ʂ", "aspirated": false,
      "noteVi": "Xát uốn lưỡi — không phải 's' tiếng Việt cũng không phải 'sh' tiếng Anh.",
      "examples": [{ "pinyin": "shui3", "hanzi": "水" }] },
    { "code": "r", "group": "uon-luoi", "display": "r", "ipa": "ʐ", "aspirated": false,
      "noteVi": "Uốn lưỡi, có ma sát nhẹ — gần 'r' tiếng Anh Mỹ hơn 'r' tiếng Việt.",
      "examples": [{ "pinyin": "ren2", "hanzi": "人" }] },
    { "code": "z", "group": "dau-luoi-truoc", "display": "z", "ipa": "ts", "aspirated": false,
      "noteVi": "Đầu lưỡi chạm mặt sau răng cửa trên, không bật hơi.",
      "examples": [{ "pinyin": "zai4", "hanzi": "在" }] },
    { "code": "c", "group": "dau-luoi-truoc", "display": "c", "ipa": "tsʰ", "aspirated": true,
      "noteVi": "Như 'z' nhưng bật hơi mạnh — gần 'x' tiếng Việt đọc bật hơi.",
      "examples": [{ "pinyin": "cai2", "hanzi": "财" }] },
    { "code": "s", "group": "dau-luoi-truoc", "display": "s", "ipa": "s", "aspirated": false,
      "noteVi": "Giống 's' tiếng Việt/tiếng Anh.",
      "examples": [{ "pinyin": "san1", "hanzi": "三" }] }
  ]
}
