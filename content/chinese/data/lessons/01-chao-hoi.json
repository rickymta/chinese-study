      "payload": {
        "paragraphs": [
          "Câu chào phổ biến nhất trong tiếng Trung là [[你好|ni3 hao3]], dùng được với hầu hết mọi người.",
          "Với thầy cô hoặc người lớn tuổi, người Trung Quốc thường dùng [[您好|nin2 hao3]] để lịch sự hơn.",
          "Khi chia tay, chỉ cần nói [[再见|zai4 jian4]] là đủ."
        ]
      }
    },
    {
      "type": "dialogue",
      "payload": {
        "title": "Gặp nhau buổi sáng",
        "lines": [
          { "speaker": "Lan", "hanzi": "你好！", "pinyin": "Ni3 hao3!", "vi": "Chào bạn!" },
          { "speaker": "Minh", "hanzi": "你好！", "pinyin": "Ni3 hao3!", "vi": "Chào bạn!" },
          { "speaker": "Lan", "hanzi": "谢谢你！", "pinyin": "Xie4 xie5 ni3!", "vi": "Cảm ơn bạn!" },
          { "speaker": "Minh", "hanzi": "不客气。", "pinyin": "Bu4 ke4 qi5.", "vi": "Không có chi." }
        ]
      }
    },
    {
