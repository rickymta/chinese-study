{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antfarms.xyz/schemas/chinese/hsk1-overrides.schema.json",
  "title": "Ghi đè cách đọc/phồn thể cho các mục đa âm của HSK 3.0 cấp 1 (content/chinese/sources/hsk1-overrides.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["byOfficialIndex"],
  "properties": {
    "byOfficialIndex": {
      "type": "object",
      "propertyNames": { "pattern": "^[1-9][0-9]{0,2}$" },
      "additionalProperties": { "$ref": "#/$defs/override" }
    }
  },
  "$defs": {
    "override": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "pinyin": { "type": "string", "pattern": "^[A-Za-z]+[1-5]( [A-Za-z]+[1-5])*$" },
        "traditional": { "type": "string", "minLength": 1, "maxLength": 32 },
        "meaningsVi": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
