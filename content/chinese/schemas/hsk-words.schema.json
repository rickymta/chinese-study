{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antfarms.xyz/schemas/chinese/hsk-words.schema.json",
  "title": "Từ vựng HSK 3.0 (mục tiêu cấp 1 — 500 từ, F6.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "version", "standard", "license", "counts", "words"],
  "properties": {
    "dataset": { "const": "hsk-words" },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "standard": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["words", "byHsk3Level", "meaningViSource"],
      "properties": {
        "words": { "type": "integer", "minimum": 0 },
        "byHsk3Level": {
          "type": "object",
          "propertyNames": { "pattern": "^[1-7]$" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "meaningViSource": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cvdict": { "type": "integer", "minimum": 0 },
            "machine": { "type": "integer", "minimum": 0 },
            "manual": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/word" }
    }
  },
  "$defs": {
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "officialIndex", "simplified", "traditional", "variants", "pinyin",
        "hsk3Level", "hsk2Level", "hskExam2026Level", "pathOrder", "frequencyRank",
        "pos", "usageNote", "meaningsEn", "meaningsVi", "meaningViStatus", "meaningViSource",
        "hanViet", "hanVietStatus", "sources"
      ],
      "properties": {
        "officialIndex": { "type": ["integer", "null"], "minimum": 1, "maximum": 9999 },
        "simplified": { "type": "string", "minLength": 1, "maxLength": 32 },
        "traditional": { "type": ["string", "null"], "minLength": 1, "maxLength": 32 },
        "variants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 32 }
        },
        "pinyin": { "type": "string", "pattern": "^[A-Za-z]+[1-5]( [A-Za-z]+[1-5])*$" },
        "hsk3Level": { "type": ["integer", "null"], "minimum": 1, "maximum": 7 },
        "hsk2Level": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
        "hskExam2026Level": { "type": ["integer", "null"], "minimum": 1, "maximum": 7 },
        "pathOrder": { "type": ["integer", "null"], "minimum": 1 },
        "frequencyRank": { "type": ["integer", "null"], "minimum": 1 },
        "pos": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z]{1,3}$" }
        },
        "usageNote": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
        "meaningsEn": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "meaningsVi": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "meaningViStatus": { "enum": ["machine", "reviewed"] },
        "meaningViSource": { "enum": ["cvdict", "machine", "manual"] },
        "hanViet": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
        "hanVietStatus": { "enum": ["derived", "reviewed", null] },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
