{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antfarms.xyz/schemas/chinese/meaning-vi-machine.schema.json",
  "title": "Nghĩa tiếng Việt dịch máy cho các mục CVDICT không phủ hoặc bị lọc rỗng (content/chinese/sources/meaning-vi-machine.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simplified", "pinyin", "meaningsVi", "fromEn"],
      "properties": {
        "simplified": { "type": "string", "minLength": 1, "maxLength": 32 },
        "pinyin": { "type": "string", "pattern": "^[A-Za-z]+[1-5]( [A-Za-z]+[1-5])*$" },
        "meaningsVi": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "fromEn": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
