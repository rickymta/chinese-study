{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antfarms.xyz/schemas/chinese/pinyin-initials.schema.json",
  "title": "Bảng thanh mẫu (initials) — Hán ngữ pinyin",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "version", "items"],
  "properties": {
    "dataset": { "const": "pinyin-initials" },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/initial" }
    }
  },
  "$defs": {
    "initial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "group", "display", "ipa", "aspirated", "noteVi", "examples"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z]{0,2}$" },
        "group": { "enum": ["khong", "moi", "dau-luoi", "cuong-luoi", "mat-luoi", "dau-luoi-truoc", "uon-luoi"] },
        "display": { "type": "string", "maxLength": 2 },
        "ipa": { "type": "string", "maxLength": 8 },
        "aspirated": { "type": "boolean" },
        "noteVi": { "type": "string", "minLength": 1, "maxLength": 300 },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pinyin", "hanzi"],
            "properties": {
              "pinyin": { "type": "string", "pattern": "^[A-Za-z]+[1-5]$" },
              "hanzi": { "type": "string", "minLength": 1, "maxLength": 4 }
            }
          }
        }
      }
    }
  }
}
