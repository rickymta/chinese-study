{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antfarms.xyz/schemas/chinese/pinyin-finals.schema.json",
  "title": "Bảng vận mẫu (finals) — Hán ngữ pinyin",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "version", "items"],
  "properties": {
    "dataset": { "const": "pinyin-finals" },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/final" }
    }
  },
  "$defs": {
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "group", "display", "standaloneSpelling", "noteVi"],
      "properties": {
        "code": { "type": "string", "pattern": "^-?[a-z]{1,4}$" },
        "group": { "enum": ["don", "kep", "mui", "i", "u", "v", "dac-biet"] },
        "display": { "type": "string", "minLength": 1, "maxLength": 5 },
        "standaloneSpelling": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-z]{1,5}$" },
            { "type": "null" }
          ]
        },
        "noteVi": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    }
  }
}
