{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antfarms.xyz/schemas/chinese/pinyin-syllables.schema.json",
  "title": "Bảng âm tiết pinyin đầy đủ + chữ minh hoạ theo từng thanh",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "version", "items"],
  "properties": {
    "dataset": { "const": "pinyin-syllables" },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/syllable" }
    }
  },
  "$defs": {
    "syllable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syllable", "initial", "final", "tones"],
      "properties": {
        "syllable": { "type": "string", "pattern": "^[a-z]{1,6}$" },
        "initial": { "type": "string", "pattern": "^[a-z]{0,2}$" },
        "final": { "type": "string", "pattern": "^-?[a-z]{1,4}$" },
        "tones": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": { "enum": ["1", "2", "3", "4"] },
          "properties": {
            "1": { "$ref": "#/$defs/toneExample" },
            "2": { "$ref": "#/$defs/toneExample" },
            "3": { "$ref": "#/$defs/toneExample" },
            "4": { "$ref": "#/$defs/toneExample" }
          }
        }
      }
    },
    "toneExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hanzi", "meaningVi"],
      "properties": {
        "hanzi": { "type": "string", "minLength": 1, "maxLength": 8 },
        "meaningVi": { "type": "string", "minLength": 1, "maxLength": 60 }
      }
    }
  }
}
