{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antfarms.xyz/schemas/chinese/pinyin-guide.schema.json",
  "title": "Nội dung hướng dẫn pinyin & thanh điệu (giai đoạn G0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "version", "items"],
  "properties": {
    "dataset": { "const": "pinyin-guide" },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/topic" }
    }
  },
  "$defs": {
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "order", "blocks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "order": { "type": "integer", "minimum": 1 },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/blockParagraph" },
              { "$ref": "#/$defs/blockToneContour" },
              { "$ref": "#/$defs/blockExamples" },
              { "$ref": "#/$defs/blockCompare" },
              { "$ref": "#/$defs/blockTip" }
            ]
          }
        }
      }
    },
    "pinyinNumbered": { "type": "string", "pattern": "^[A-Za-z]+[1-5]( [A-Za-z]+[1-5])*$" },
    "exampleItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pinyin", "hanzi"],
      "properties": {
        "pinyin": { "$ref": "#/$defs/pinyinNumbered" },
        "hanzi": { "type": "string", "minLength": 1, "maxLength": 12 },
        "meaningVi": { "type": "string", "minLength": 1, "maxLength": 60 }
      }
    },
    "blockParagraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "blockToneContour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tones"],
      "properties": {
        "type": { "const": "tone_contour" },
        "tones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "integer", "enum": [1, 2, 3, 4] }
        }
      }
    },
    "blockExamples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "examples" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/exampleItem" } }
      }
    },
    "blockCompare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "pairs"],
      "properties": {
        "type": { "const": "compare" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["left", "right"],
            "properties": {
              "left": { "$ref": "#/$defs/exampleItem" },
              "right": { "$ref": "#/$defs/exampleItem" },
              "noteVi": { "type": "string", "maxLength": 300 }
            }
          }
        }
      }
    },
    "blockTip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "tip" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
