{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antfarms.xyz/schemas/chinese/characters.schema.json",
  "title": "Chữ Hán dùng trong hsk-words.json (F6.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "version", "license", "characters"],
  "properties": {
    "dataset": { "const": "characters" },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "license": { "type": "string", "minLength": 1 },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/character" }
    }
  },
  "$defs": {
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hanzi", "traditionalVariants", "pinyinReadings", "hanViet", "hanVietByPinyin",
        "hanVietStatus", "strokeCount", "radical", "radicalNumber", "sources"
      ],
      "properties": {
        "hanzi": { "type": "string", "minLength": 1, "maxLength": 4 },
        "traditionalVariants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 4 }
        },
        "pinyinReadings": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z]+[1-5]$" }
        },
        "hanViet": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 32 }
        },
        "hanVietByPinyin": {
          "type": ["object", "null"],
          "propertyNames": { "pattern": "^[a-z]+[1-5]$" },
          "additionalProperties": { "type": "string", "maxLength": 32 }
        },
        "hanVietStatus": { "enum": ["derived", "reviewed"] },
        "strokeCount": { "type": ["integer", "null"], "minimum": 1, "maximum": 64 },
        "radical": { "type": ["string", "null"], "minLength": 1, "maxLength": 4 },
        "radicalNumber": { "type": ["integer", "null"], "minimum": 1, "maximum": 214 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
