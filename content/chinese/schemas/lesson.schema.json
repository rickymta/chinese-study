{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antfarms.xyz/schemas/chinese/lesson.schema.json",
  "title": "Bài học chủ đề HSK 1 + quiz (F9)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "slug", "title", "topic", "level", "orderIndex",
    "status", "summary", "objectives", "estimatedMinutes", "sources",
    "words", "glossary", "blocks", "quiz"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 3, "maxLength": 64 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "topic": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" },
    "level": { "const": "hsk1" },
    "orderIndex": { "type": "integer", "minimum": 1, "maximum": 999 },
    "status": { "enum": ["draft", "published"] },
    "summary": { "type": "string", "maxLength": 1000 },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 120 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/word" }
    },
    "glossary": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/glossaryItem" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/block" }
    },
    "quiz": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/quizQuestion" }
    }
  },
  "$defs": {
    "pinyinNumbered": {
      "type": "string",
      "pattern": "^[A-Za-z]+[1-5]( [A-Za-z]+[1-5])*$"
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simplified", "pinyin"],
      "properties": {
        "simplified": { "type": "string", "minLength": 1, "maxLength": 32 },
        "pinyin": { "$ref": "#/$defs/pinyinNumbered" }
      }
    },
    "glossaryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hanzi", "pinyin", "vi"],
      "properties": {
        "hanzi": { "type": "string", "minLength": 1, "maxLength": 10 },
        "pinyin": { "$ref": "#/$defs/pinyinNumbered" },
        "vi": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "dialogueLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "hanzi", "pinyin", "vi"],
      "properties": {
        "speaker": { "type": "string", "minLength": 1, "maxLength": 20 },
        "hanzi": { "type": "string", "minLength": 1, "maxLength": 100 },
        "pinyin": { "type": "string", "minLength": 1, "maxLength": 300 },
        "vi": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "grammarExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hanzi", "pinyin", "vi"],
      "properties": {
        "hanzi": { "type": "string", "minLength": 1, "maxLength": 100 },
        "pinyin": { "type": "string", "minLength": 1, "maxLength": 300 },
        "vi": { "type": "string", "minLength": 1, "maxLength": 300 },
        "note": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "textPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraphs"],
      "properties": {
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "dialoguePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lines"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/dialogueLine" }
        }
      }
    },
    "grammarPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "explanation", "examples"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 200 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "examples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/grammarExample" }
        }
      }
    },
    "tipPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "variant": { "enum": ["pronunciation", "culture", "memory", "grammar"] }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "enum": ["text", "dialogue", "grammar", "tip"] },
        "payload": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "text" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/textPayload" } } } },
        { "if": { "properties": { "type": { "const": "dialogue" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/dialoguePayload" } } } },
        { "if": { "properties": { "type": { "const": "grammar" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/grammarPayload" } } } },
        { "if": { "properties": { "type": { "const": "tip" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/tipPayload" } } } }
      ]
    },
    "quizOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "lang"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-d]$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "lang": { "enum": ["vi", "zh", "pinyin"] }
      }
    },
    "quizQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "prompt", "promptLang", "options", "correctOptionId", "explanation"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "type": { "enum": ["single_choice", "listen_choice"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 300 },
        "promptLang": { "enum": ["vi", "zh"] },
        "promptPinyin": { "type": "string", "minLength": 1, "maxLength": 300 },
        "audioText": { "type": "string", "minLength": 1, "maxLength": 100 },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/quizOption" }
        },
        "correctOptionId": { "type": "string", "pattern": "^[a-d]$" },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
