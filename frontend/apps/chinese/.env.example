# Chép thành .env (gitignore) nếu cần đổi. Biến VITE_* được NƯỚNG vào bundle lúc build.
# Dev: identity đi cùng origin qua Vite proxy /identity → gateway :5280.
# Production build: https://id.antfarms.xyz/api (Dockerfile đã đặt mặc định; compose truyền build arg).
VITE_IDENTITY_API_URL=/identity/api
