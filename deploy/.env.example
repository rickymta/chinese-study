# Chép thành deploy/.env rồi điền giá trị thật. Bản đã điền KHÔNG được git theo dõi.

# ── Tên miền ─────────────────────────────────────────────────────────────────
APP_DOMAIN=antfarms.xyz
# Server thật đặt 0.0.0.0; máy chưa cấu hình tường lửa để mặc định 127.0.0.1.
PUBLIC_BIND=127.0.0.1

# ── Let's Encrypt ────────────────────────────────────────────────────────────
# CHỈ để tiện ghi nhớ/kiểm ở preflight.sh — scripts/get-cert.sh (đúng khuôn MedDental)
# LUÔN nhận email qua ĐỐI SỐ dòng lệnh, không tự đọc file .env (script dùng chung cho
# nhiều bộ tên miền/nhiều lần chạy FORCE=1, không nên ẩn nguồn giá trị bên trong script).
# Trước khi chạy get-cert.sh: `set -a && source .env && set +a` rồi gọi
# `./scripts/get-cert.sh "$LETSENCRYPT_EMAIL" <ten_mien...>`, hoặc gõ thẳng email — xem
# deploy/README.md mục HTTPS. Email rỗng ("") vẫn được script coi là MỘT đối số hợp lệ (không
# bị chặn bởi `$# -lt 2`) nhưng certbot --non-interactive coi chuỗi rỗng như "chưa có email",
# đòi hỏi `--email` hoặc `--register-unsafely-without-email` ⇒ tự dừng với lỗi rõ ràng, không
# lặng lẽ cấp chứng chỉ thiếu email liên hệ.
LETSENCRYPT_EMAIL=

# ── Registry ảnh (để trống = build tại chỗ bằng docker compose build) ────────
# Mặc định compose dùng "localhost/antfarm" khi để trống (KHÔNG phải "antfarm" trơn) — xem
# ghi chú đầu deploy/docker-compose.yml. Chỉ điền REGISTRY khi đã có registry riêng thật.
REGISTRY=
IDENTITY_SERVICE_TAG=
CHINESE_BACKEND_TAG=
GATEWAY_TAG=
CHINESE_FRONTEND_TAG=
CMS_BACKEND_TAG=
ADMIN_FRONTEND_TAG=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Mật khẩu riêng cho role af_identity / af_chinese / af_cms — deploy/postgres/init/01-create-databases.sh đọc các biến này.
AF_IDENTITY_DB_PASSWORD=
AF_CHINESE_DB_PASSWORD=
AF_CMS_DB_PASSWORD=

# ── identity-service ─────────────────────────────────────────────────────────
AUTH_ALLOW_REGISTRATION=false

# ── chinese-backend ──────────────────────────────────────────────────────────
# Đường vào lần đầu: email này được gán vai trò admin lúc provision (R-P6).
CHINESE_ADMIN_EMAIL=admin@antfarms.xyz

# ── cms-backend (W1) ─────────────────────────────────────────────────────────
# Đường vào lần đầu: email này được gán vai trò admin (toàn quyền CMS) lúc provision (R-W10).
CMS_BOOTSTRAP_ADMIN_EMAIL=admin@antfarms.xyz
