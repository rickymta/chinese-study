# Chép thành deploy/.env rồi điền giá trị thật. Bản đã điền KHÔNG được git theo dõi.

# ── Tên miền ─────────────────────────────────────────────────────────────────
APP_DOMAIN=antfarms.xyz
# Server thật đặt 0.0.0.0; máy chưa cấu hình tường lửa để mặc định 127.0.0.1.
PUBLIC_BIND=127.0.0.1

# ── Let's Encrypt ────────────────────────────────────────────────────────────
LETSENCRYPT_EMAIL=

# ── Registry ảnh (để trống = build tại chỗ bằng docker compose build) ────────
REGISTRY=
IDENTITY_SERVICE_TAG=
CHINESE_BACKEND_TAG=
GATEWAY_TAG=
CHINESE_FRONTEND_TAG=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Mật khẩu riêng cho role af_identity / af_chinese — deploy/postgres/init/01-create-databases.sh đọc hai biến này.
AF_IDENTITY_DB_PASSWORD=
AF_CHINESE_DB_PASSWORD=

# ── identity-service ─────────────────────────────────────────────────────────
AUTH_ALLOW_REGISTRATION=false

# ── chinese-backend ──────────────────────────────────────────────────────────
# Đường vào lần đầu: email này được gán vai trò admin lúc provision (R-P6).
CHINESE_ADMIN_EMAIL=admin@antfarms.xyz
