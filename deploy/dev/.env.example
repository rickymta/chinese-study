# Chép thành deploy/dev/.env — dùng cho deploy/dev/docker-compose.dev.yml (chỉ DEV,
# không dùng cho production). Giữ nguyên giá trị mặc định là chạy được ngay; đổi
# tuỳ ý nếu máy đã có cổng 5432/9000/9001 bị chiếm bởi dịch vụ khác.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Mật khẩu riêng cho role af_identity / af_chinese / af_cms (đọc bởi deploy/postgres/init/01-create-databases.sh).
# Khớp với ConnectionStrings:Default trong appsettings.Development.json của từng service.
AF_IDENTITY_DB_PASSWORD=af_identity_dev
AF_CHINESE_DB_PASSWORD=af_chinese_dev
AF_CMS_DB_PASSWORD=af_cms_dev

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
