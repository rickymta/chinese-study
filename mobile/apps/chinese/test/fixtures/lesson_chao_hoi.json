    {
      "id": "01a0ad13-dc1a-7a8b-be54-40dc02ec5350",
      "type": "grammar",
      "payload": {
        "title": "Câu hỏi có/không với 吗",
        "pattern": "Câu trần thuật + [[吗|ma5]]？",
        "examples": [
          {
            "vi": "Bạn khoẻ không?",
            "note": "Lời hỏi thăm quen thuộc, không phải câu chào lần đầu",
            "hanzi": "你好吗？",
            "pinyin": "Ni3 hao3 ma5?"
          },
          {
            "vi": "Thưa thầy/cô, thầy/cô khoẻ không?",
            "hanzi": "老师，您好吗？",
            "pinyin": "Lao3 shi1, nin2 hao3 ma5?"
          }
        ],
        "explanation": "Thêm [[吗|ma5]] vào cuối một câu trần thuật để biến nó thành câu hỏi có/không — người nghe chỉ cần trả lời có hoặc không."
      }
    },
    {
      "id": "01a0ad13-dc1a-7c6a-9524-c4a3172bc64d",
      "type": "grammar",
      "payload": {
        "title": "您 — cách xưng hô lịch sự",
        "examples": [
          {
            "vi": "Chào thầy/cô ạ!",
            "note": "Dùng khi gặp người lớn tuổi/thầy cô",
            "hanzi": "您好！",
            "pinyin": "Nin2 hao3!"
          }
        ],
        "explanation": "[[您|nin2]] là cách xưng hô lịch sự của [[你|ni3]], dùng với thầy cô, người lớn tuổi hoặc người mới gặp lần đầu cần tôn trọng."
      }
    },
    {
      "id": "01a0ad13-dc1a-7752-9dcc-dbe6d5e90db0",
      "type": "grammar",
      "payload": {
        "title": "们 — số nhiều của đại từ",
        "pattern": "Đại từ (我/你/他) + [[们|men5]]",
        "examples": [
          {
            "vi": "Chào các bạn!",
            "hanzi": "你们好！",
            "pinyin": "Ni3 men5 hao3!"
          },
          {
            "vi": "Chị ấy khoẻ.",
            "note": "她 dùng để chỉ một người nữ, số ít",
            "hanzi": "她好。",
            "pinyin": "Ta1 hao3."
          }
        ],
        "explanation": "Thêm [[们|men5]] sau đại từ nhân xưng để chỉ số nhiều: [[我们|wo3 men5]] (chúng tôi/chúng ta), [[你们|ni3 men5]] (các bạn), [[他们|ta1 men5]] (họ)."
      }
    },
    {
      "id": "01a0ad13-dc1a-7758-bf46-c50fb93ef36f",
      "type": "tip",
      "payload": {
        "text": "Hai thanh 3 đứng liền nhau: thanh đầu đọc gần giống thanh 2. [[你好|ni3 hao3]] nghe như \"ní hǎo\", nhưng pinyin vẫn viết giữ thanh gốc \"nǐ hǎo\".",
        "variant": "pronunciation"
      }
    },
    {
      "id": "01a0ad13-dc1b-76ff-91a5-f32c0e37376f",
      "type": "tip",
      "payload": {
        "text": "[[谢谢|xie4 xie5]] có âm sau đọc nhẹ và ngắn hơn (thanh nhẹ, số 5) — không nhấn như âm đầu.",
        "variant": "pronunciation"
      }
    }
  ],
